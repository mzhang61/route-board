{$SITE_ADDRESS:localhost} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' {$OIDC_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
    @backend path /api/* /mcp /mcp/* /healthz
    handle @backend {
        # SSE responses are flushed automatically; preserve cancellation on disconnect.
        reverse_proxy api:8080
    }
    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
